@model EcommerceMVC.ViewModels.ChiTietHangHoaVM
@{
    ViewData["Title"] = Model.TenHh;
    Layout = "_DanhSachHangHoa";
}

<div class="product-page">
    <div class="row">
        <div class="col-md-6 col-sm-6">
            <div class="product-main-image">
                @{
                    var hinhPath = Model.Hinh;
                    if (!string.IsNullOrEmpty(hinhPath) && !hinhPath.Contains("/"))
                    {
                        hinhPath = "/Hinh/Hinh/HangHoa/" + hinhPath;
                    }
                }
                <img src="@Url.Content("~" + hinhPath)" alt="@Model.TenHh" class="img-responsive" onerror="this.src='/Hinh/Hinh/HangHoa/To.gif'">
            </div>
        </div>
        <div class="col-md-6 col-sm-6">
            <h1>@Model.TenHh</h1>
            <div class="price-availability-block clearfix">
                <div class="price">
                    <strong><span>$</span>@Model.DonGia</strong>
                </div>
                <div class="availability">
                    Tình trạng: <strong>Còn hàng</strong>
                </div>
            </div>
            <div class="description">
                <p>@Model.MoTaNgan</p>
            </div>
            <div class="product-page-cart">
                <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.MaHh" method="post">
                    <div class="product-quantity">
                        <input id="product-quantity" type="text" value="1" name="quantity" readonly class="form-control input-sm">
                    </div>
                    <button class="btn btn-primary" type="submit">Thêm vào giỏ</button>
                    <a asp-controller="YeuThich" asp-action="Add" asp-route-id="@Model.MaHh" class="btn btn-default"><i class="fa fa-heart"></i> Yêu thích</a>
                </form>
            </div>
            <div class="review">
                <input type="range" min="1" max="5" value="@Model.DiemDanhGia" class="rateit" readonly>
                <a href="javascript:;">7 đánh giá</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="javascript:;">Viết đánh giá</a>
            </div>
        </div>

        <div class="product-page-content">
            <ul id="myTab" class="nav nav-tabs">
                <li class="active"><a href="#Description" data-toggle="tab">Mô tả chi tiết</a></li>
                <li><a href="#Information" data-toggle="tab">Thông tin bổ sung</a></li>
            </ul>
            <div id="myTabContent" class="tab-content">
                <div class="tab-pane fade in active" id="Description">
                    @if (string.IsNullOrEmpty(Model.MoTaChiTiet))
                    {
                        <p>@Model.MoTaNgan</p>
                    }
                    else
                    {
                        @Html.Raw(Model.MoTaChiTiet)
                    }
                </div>
                <div class="tab-pane fade" id="Information">
                    <table class="datasheet">
                        <tr>
                            <th colspan="2">Đặc điểm nổi bật</th>
                        </tr>
                        <tr>
                            <td class="datasheet-features-type">Loại hàng</td>
                            <td>@Model.TenLoai</td>
                        </tr>
                        <tr>
                            <td class="datasheet-features-type">Mã sản phẩm</td>
                            <td>@Model.MaHh</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="sticker sticker-sale"></div>
    </div>
</div>
