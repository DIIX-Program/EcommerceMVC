<!-- Modal -->
<div class="modal fade" id="saleModal" tabindex="-1" role="dialog" aria-labelledby="saleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="saleModalLabel">🔥 SIÊU SALE 15/5 🔥</h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="opacity: 1;">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body text-center">
        <h3 class="text-danger">GIẢM GIÁ CỰC SỐC!</h3>
        <p>Nhập mã <strong>SALE155</strong> để được giảm ngay 15% cho tất cả đơn hàng.</p>
        <img src="~/Hinh/Hinh/HangHoa/1004.jpg" class="img-fluid my-3" alt="Sale" style="max-height:200px" onerror="this.style.display='none'">
        <p class="text-muted">Áp dụng đến hết ngày 15/5. Nhanh tay kẻo lỡ!</p>
      </div>
      <div class="modal-footer justify-content-center">
        <a href="/HangHoa/Index" class="btn btn-primary btn-lg">Mua ngay</a>
        <button type="button" class="btn btn-secondary btn-lg" data-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (!sessionStorage.getItem('salePopupShown')) {
            setTimeout(function() {
                $('#saleModal').modal('show');
                sessionStorage.setItem('salePopupShown', 'true');
            }, 1000); // Hiện sau 1s
        }
    });
</script>
