@model EcommerceMVC.ViewModels.CartModel

<div class="top-cart-block">
    <div class="top-cart-info">
        <a asp-controller="Cart" asp-action="Index" class="top-cart-info-count">@Model.Quantity items</a>
        <a asp-controller="Cart" asp-action="Index" class="top-cart-info-value">$@Model.Total</a>
    </div>
    <i class="fa fa-shopping-cart"></i>

    <div class="top-cart-content-wrapper">
        <div class="top-cart-content">
            <div class="text-right">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-default">View Cart</a>
                <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary">Checkout</a>
            </div>
        </div>
    </div>
</div>
