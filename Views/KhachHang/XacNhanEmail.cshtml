@{
    ViewData["Title"] = "Xác nhận Email";
}

<div class="container-fluid py-5">
    <div class="container py-5">
        <h1 class="mb-4">Xác nhận Email</h1>
        <form asp-action="XacNhanEmail" method="post">
            <div class="text-danger" asp-validation-summary="All"></div>
            <div class="row justify-content-center">
                <div class="col-md-12 col-lg-6">
                    <p>Mã xác nhận 6 số đã được gửi đến email <strong>@ViewBag.Email</strong>.</p>
                    <p>Vui lòng kiểm tra email và nhập mã vào bên dưới để kích hoạt tài khoản.</p>
                    
                    <input type="hidden" name="email" value="@ViewBag.Email" />
                    
                    <div class="form-item w-100">
                        <label class="form-label my-3">Mã xác nhận 6 số</label><sup>*</sup>
                        <input type="text" name="code" class="form-control" required maxlength="6" pattern="\d{6}" placeholder="Nhập mã 6 số">
                    </div>
                    
                    <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                        <button type="submit" class="btn border-secondary py-3 px-4 text-uppercase w-100 text-primary">Xác nhận</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
